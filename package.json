{
  "name": "@diamondslab/hardhat-diamonds",
  "version": "1.2.0",
  "description": "Tools for deploying and interfacing with ERC-2535 Diamond Proxies",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./dist/utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./dist/lib": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "ethereum",
    "smart-contracts",
    "hardhat",
    "hardhat-plugin",
    "diamond",
    "diamond-proxy",
    "diamond-upgradeable",
    "blockchain",
    "erc-2535"
  ],
  "author": "Am0rfu5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiamondsLab/hardhat-diamonds.git"
  },
  "bugs": {
    "url": "https://github.com/DiamondsLab/hardhat-diamonds/issues"
  },
  "homepage": "https://github.com/DiamondsLab/hardhat-diamonds#readme",
  "engines": {
    "node": ">=18",
    "yarn": ">=4"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint:fix": "prettier --write 'src/**/*.{js,ts}' 'test/**/*.{js,ts}' && yarn exec eslint --fix 'src/**/*.{js,ts}' 'test/**/*.{js,ts}'",
    "lint": "yarn exec eslint 'src/**/*.{js,ts}' 'test/**/*.{js,ts}'",
    "build": "tsc",
    "watch": "tsc -w",
    "prepack": "tsc --build --force",
    "prepublishOnly": "npm run build",
    "test": "yarn exec hardhat test",
    "test:comprehensive": "yarn exec hardhat test test/unit/core/DiamondsConfig.test.ts test/unit/core/HardhatPlugin.test.ts test/integration/e2e/ConfigurationManagement.test.ts",
    "test:core": "yarn exec hardhat test test/unit/core/DiamondsConfig.test.ts test/unit/core/HardhatPlugin.test.ts",
    "test:existing": "yarn exec hardhat test test/unit/diamonds-config.test.ts test/project.test.ts",
    "test:config": "yarn exec hardhat test test/integration/e2e/ConfigurationManagement.test.ts"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "docs/VERSIONING.md"
  ],
  "devDependencies": {
    "@diamondslab/diamonds": "^1.0.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomicfoundation/ignition-core": "^0.15.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.3.19",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.8",
    "@types/node": "^22.5.5",
    "@types/sinon": "^17.0.3",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@typescript-eslint/types": "^8.8.0",
    "chai": "^4.5.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "ethers": "^6.13.3",
    "hardhat": "^2.26.5",
    "hardhat-gas-reporter": "^1.0.9",
    "mocha": "^10.7.3",
    "prettier": "^3.3.3",
    "sinon": "^19.0.2",
    "solidity-coverage": "^0.8.0",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.0",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "@diamondslab/diamonds": "^1.0.0",
    "ethers": "^6.0.0",
    "hardhat": "^2.0.0"
  },
  "packageManager": "yarn@4.10.3",
  "dependencies": {
    "chalk": "^4.1.2"
  }
}
